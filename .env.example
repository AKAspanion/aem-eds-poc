# Tokens for the scripts in drafts/da/ (upload.sh, register-index.sh, switch-to-da.sh).
# Copy to .env and fill in. .env is git-ignored and never served by Edge Delivery.
# Tokens expire (roughly a day); refresh them when a script reports 401.

# da.live: sign in at https://da.live/#/akaspanion/aem-eds-poc, then in DevTools run
#   copy(window.adobeIMS.getAccessToken().token)
DA_TOKEN=

# admin.hlx.page: sign in at https://admin.hlx.page/login, then DevTools >
# Application > Cookies > admin.hlx.page > auth_token
HLX_TOKEN=

# Production host, bare (e.g. www.example.com). Used by configure-cdn.sh
# (Adobe-managed CDN, cdn.prod.host) and the robots.txt Sitemap line.
PROD_HOST=

# Target Edge Delivery site for all drafts/da scripts (default: the POC).
# For the Cloud Manager site: EDS_ORG=adobe-cm, EDS_SITE=cm-p62213-s44386-prohance-malaysia-website-poc
EDS_ORG=
EDS_SITE=
