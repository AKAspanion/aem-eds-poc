{
  "default": "en",
  "translationsPath": "/config/translations",
  "preview": {
    "queryParam": "locale",
    "storageKey": "hlx-locale"
  },
  "languages": [
    { "code": "en", "label": "EN", "hostname": "www.example.com" },
    { "code": "fr", "label": "FR", "hostname": "www.example.fr" },
    { "code": "de", "label": "DE", "hostname": "www.example.de" }
  ],
  "domains": {
    "localhost": "en",
    "www.example.com": "en",
    "example.com": "en",
    "www.example.fr": "fr",
    "example.fr": "fr",
    "www.example.de": "de",
    "example.de": "de"
  }
}
