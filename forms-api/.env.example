# Copy to forms-api/.env (git-ignored). `aio app use` also writes AIO_* values here.

# AEM author tier: the Content Fragments API only exists on author
AEM_AUTHOR_HOST=https://author-pXXXXX-eYYYYY.adobeaemcloud.com

# AEM service credentials JSON (AEM Developer Console > Integrations > Technical Accounts),
# on ONE line. The technical account needs DAM write on
# /content/dam/prohance-website/site-a/form-data.
AEM_SERVICE_CREDENTIALS_JSON=

# Comma-separated origins allowed to POST (no trailing slash)
ALLOWED_ORIGINS=https://main--aem-eds-poc--akaspanion.aem.page,https://main--aem-eds-poc--akaspanion.aem.live

# Submissions allowed per visitor IP per hour per form (0 = off)
RATE_LIMIT_PER_HOUR=10

# Optional Cloudflare Turnstile secret; when set, forms must send `cf-turnstile-response`
TURNSTILE_SECRET=
